#
# Example environment configuration. Copy to `.env` and fill in real values.
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Source it into your shell
# (`set -a; source .env; set +a`) or let your CI inject these as secrets.
# All values below are non-secret placeholders.
# SECURITY: Never store production secrets in .env. Use AWS Secrets Manager or AWS Systems Manager Parameter Store. This file holds non-sensitive placeholders for local development only.

# --- AWS account / region ---------------------------------------------------
# Used by the CDK app (examples/vehicle-auction-agent/cdk/app.py) and integration tests.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1
ENVIRONMENT=dev

# --- Deployed AgentCore runtime --------------------------------------------
# Real end-to-end tests (tests/integration/test_real_agent_eval.py) and the
# post-deploy smoke test invoke this runtime. Leave as the EXAMPLE placeholder
# to skip those tests; set it to your deployed runtime ARN to run them.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-west-1:123456789012:runtime/agent_eval_runtime_dev-EXAMPLE

# Immutable ECR digest URI for the agent container (built by CodeBuild). When
# unset, the CDK agent_runtime stack is skipped.
AGENT_IMAGE_URI=123456789012.dkr.ecr.eu-west-1.amazonaws.com/agent-eval-runtime@sha256:EXAMPLE

# --- Agent runtime data sources --------------------------------------------
DATA_BUCKET=amzn-s3-demo-bucket-agent-eval-data-dev
LANCEDB_PATH=lancedb/manifest.json
DEALERS_TABLE=agent-eval-dealers-dev

# --- Models / evaluation ----------------------------------------------------
# Bedrock model the agent uses, and the LLM-as-judge model for evaluation.
MODEL_ID=eu.anthropic.claude-sonnet-4-6
JUDGE_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# Path to the evaluation config (defaults to ./eval_config.yaml when unset).
EVAL_CONFIG_PATH=eval_config.yaml
# Set to "true" to skip Bedrock-backed LLM-as-judge tests offline.
SKIP_LLM_EVAL=false

# --- Data ingestion Lambda --------------------------------------------------
MOCK_BIGQUERY=true
SAMPLE_DATA_KEY=raw/sample_vehicles.json
METRICS_SOURCE=placeholder

# --- Dealer API -------------------------------------------------------------
# CORS allow-list origin for the Dealer API (do not use "*").
ALLOWED_ORIGIN=https://your-frontend.example.com
