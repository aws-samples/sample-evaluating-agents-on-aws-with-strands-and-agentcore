          <mxGeometry x="1220" y="395" width="88" height="88" as="geometry" />
        </mxCell>

        <mxCell id="runtimebox" value="Amazon Bedrock AgentCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#5A2D9C;spacingTop=8;" vertex="1" parent="1">
