        <mxCell id="e1" value="1. trigger" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#687078;strokeWidth=2;fontColor=#4D5965;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="eventbridge" target="lambda">
