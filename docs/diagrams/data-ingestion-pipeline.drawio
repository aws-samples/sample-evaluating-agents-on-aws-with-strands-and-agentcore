<mxfile host="app.diagrams.net" type="device">
  <diagram id="data-ingestion" name="Data Ingestion Pipeline">
    <mxGraphModel dx="1800" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Vehicle Data Ingestion and Runtime Load" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="520" y="16" width="620" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Reference implementation in eu-west-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#687078;" vertex="1" parent="1">
