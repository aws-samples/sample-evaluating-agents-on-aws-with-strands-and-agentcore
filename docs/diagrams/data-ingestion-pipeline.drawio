        <mxCell id="e4" value="4. embed" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;fontColor=#00796B;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="pipeline" target="titan">
          <mxGeometry x="-0.15" y="-10" relative="1" as="geometry">
