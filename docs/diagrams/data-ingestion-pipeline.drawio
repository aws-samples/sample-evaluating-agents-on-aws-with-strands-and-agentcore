        <mxCell id="note" value="Any normalization, embedding, validation, hash, or write failure leaves the previous manifest unchanged. Warm Runtime processes retain the last-known-good LanceDB generation and retry on the next bounded poll." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D5A000;dashed=1;fontSize=10;fontColor=#5F4B00;align=center;" vertex="1" parent="1">
