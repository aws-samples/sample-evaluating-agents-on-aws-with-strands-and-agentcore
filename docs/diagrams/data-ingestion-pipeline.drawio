<mxfile host="Claude" type="device">
  <diagram id="data-ingestion" name="Data Ingestion Pipeline">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Data Ingestion Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="340" y="16" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- AWS Cloud group -->
        <mxCell id="awscloud" value="AWS Cloud (eu-west-1)" style="sketch=0;html=1;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;fontSize=13;dashed=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1100" height="640" as="geometry" />
        </mxCell>

        <!-- Amazon Bedrock services boundary (above the main line) -->
        <mxCell id="bedrock" value="Amazon Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F5;strokeColor=#01A88D;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#00796B;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="156" y="120" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="nova" value="Amazon Nova Lite v1&#10;(enriches text)" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nova2;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="233" y="160" width="66" height="66" as="geometry" />
        </mxCell>
        <mxCell id="titan" value="Titan Text&#10;Embeddings v2" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="413" y="160" width="66" height="66" as="geometry" />
        </mxCell>

        <!-- Main pipeline line (y ~ 400) -->
        <mxCell id="eventbridge" value="Amazon EventBridge&#10;(daily refresh rule)" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="AWS Lambda&#10;Ingestion Function" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Amazon S3&#10;(LanceDB dataset)" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="72" height="72" as="geometry" />
        </mxCell>

        <!-- AgentCore boundary far right -->
        <mxCell id="agentcore" value="Amazon Bedrock AgentCore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#5A2D9C;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="AgentCore&#10;Runtime" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="865" y="386" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="memlance" value="In-memory&#10;LanceDB" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.database;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="386" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Data source (below Lambda) -->
        <mxCell id="datasource" value="Vehicle data source&#10;&#10;BigQuery (mocked in this sample —&#10;reads sample data from Amazon S3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;fontSize=11;fontColor=#37474F;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="206" y="560" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <!-- 1. triggers daily -->
        <mxCell id="e1" value="1. triggers daily" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#607D8B;strokeWidth=2;fontColor=#455A64;fontSize=11;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eventbridge" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. reads sample data (Lambda bottom -> data source top) -->
        <mxCell id="e2" value="2. reads sample data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#607D8B;strokeWidth=2;dashed=1;fontColor=#455A64;fontSize=11;startArrow=block;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="datasource">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. enriches text (Lambda top -> Nova bottom), horizontal band y=340 -->
        <mxCell id="e3" value="3. enriches text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00838F;strokeWidth=2;fontColor=#00838F;fontSize=11;startArrow=block;endArrow=block;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="nova">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="349" y="345" />
              <mxPoint x="266" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. generates embeddings (Lambda top -> Titan bottom), higher band y=320 -->
        <mxCell id="e4" value="4. generates embeddings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00838F;strokeWidth=2;fontColor=#00838F;fontSize=11;startArrow=block;endArrow=block;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="titan">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="363" y="320" />
              <mxPoint x="446" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. writes LanceDB dataset (Lambda right -> S3 left), main line y=416 -->
        <mxCell id="e5" value="5. writes LanceDB dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;fontSize=11;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. loads at cold start (S3 -> runtime) -->
        <mxCell id="e6" value="6. loads at cold start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#5A2D9C;fontSize=11;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. in-memory access (runtime -> memlance) -->
        <mxCell id="e7" value="7. in-memory access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;fontColor=#5A2D9C;fontSize=10;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="runtime" target="memlance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
