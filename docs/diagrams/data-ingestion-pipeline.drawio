        <mxCell id="bedrock" value="Amazon Bedrock embedding model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7F5;strokeColor=#01A88D;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#00796B;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="145" width="300" height="260" as="geometry" />
