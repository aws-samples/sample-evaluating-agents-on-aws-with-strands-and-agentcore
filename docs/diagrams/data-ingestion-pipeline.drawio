          <mxGeometry x="475" y="330" width="88" height="88" as="geometry" />
        </mxCell>
        <mxCell id="pipeline" value="Step 3 | Deterministic preprocessing&#10;&#10;Normalize schema&#10;Build searchable descriptions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#ED7100;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="240" height="92" as="geometry" />
