          <mxGeometry x="1468" y="405" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="dataframe" value="Local LanceDB table&#10;&#10;Native cosine search&#10;+ scalar prefilters&#10;Bounded geospatial fallback" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;" vertex="1" parent="1">
