        </mxCell>

        <mxCell id="validation" value="Publication gate&#10;&#10;Embedding success &gt;= 95%&#10;Non-empty unique IDs&#10;Finite 1,024-D vectors&#10;SHA-256 snapshot version&#10;Then write snapshot and promote manifest last" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
