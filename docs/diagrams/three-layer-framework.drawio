        </mxCell>

        <!-- Agent under test -->
        <mxCell id="agent" value="Agent&#10;Under Test" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- LAYER 1 -->
