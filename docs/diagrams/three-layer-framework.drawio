        <mxCell id="l2b" value="TrajectoryEvaluator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#527FFF;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
