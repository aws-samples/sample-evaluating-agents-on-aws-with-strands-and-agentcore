<mxfile host="Claude" type="device">
  <diagram id="three-layer" name="Evaluation Framework">
    <mxGraphModel dx="1400" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Build-Time Evaluation Framework" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="strands-agents-evals" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#687078;" vertex="1" parent="1">
