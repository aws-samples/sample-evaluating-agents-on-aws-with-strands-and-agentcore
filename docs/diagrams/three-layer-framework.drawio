        </mxCell>
        <mxCell id="l1thr" value="≥ 0.95" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontSize=15;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="160" width="110" height="60" as="geometry" />
        </mxCell>

        <!-- pass edge 1->2 -->
        <mxCell id="p1" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=3;fontColor=#2E7D32;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="layer1" target="layer2">
