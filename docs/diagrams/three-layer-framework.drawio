        <mxCell id="d1" value="LatencyEvaluator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
