        <!-- DOMAIN LAYER -->
        <mxCell id="domain" value="Domain Layer : Operational Metrics (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#1B5E20;spacingTop=6;" vertex="1" parent="1">
