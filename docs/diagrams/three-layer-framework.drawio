        <mxCell id="l3thr" value="≥ 0.90" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=none;fontSize=15;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
