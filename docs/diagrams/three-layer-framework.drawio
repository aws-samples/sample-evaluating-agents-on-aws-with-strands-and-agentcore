        <mxCell id="l1type" value="Deterministic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#B35A00;fontStyle=1;dashed=1;" vertex="1" parent="1">
