        <!-- test cases arrow into layer 1 -->
        <mxCell id="tc" value="test cases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=11;endArrow=block;" edge="1" parent="1" source="agent" target="layer1">
